import express from 'express';
import { PrismaClient } from '@prisma/client';
import { authenticateToken, AuthRequest } from '../middleware/auth';

const router = express.Router();
const prisma = new PrismaClient();

router.use(authenticateToken);

// Получить ссылку для привязки студента к Telegram
router.get('/link/:studentId', async (req: AuthRequest, res) => {
  try {
    const { studentId } = req.params;
    const userId = req.user!.userId;

    // Проверить, что студент принадлежит учителю
    const student = await prisma.student.findFirst({
      where: {
        id: studentId,
        teacherId: userId
      }
    });

    if (!student) {
      return res.status(404).json({ error: 'Student not found' });
    }

    // Получить bot username из переменных окружения или использовать дефолтный
    const botUsername = process.env.TELEGRAM_BOT_USERNAME || 'YourBotUsername';

    // Создать ссылку для привязки (используем ID студента как код)
    const linkUrl = `https://t.me/${botUsername}?start=${student.id}`;

    res.json({
      linkUrl,
      studentId: student.id,
      studentName: student.fullName,
      isLinked: !!student.telegramChatId,
      telegramUsername: student.telegramUsername
    });
  } catch (error) {
    console.error('Error generating Telegram link:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

// Отвязать студента от Telegram
router.delete('/unlink/:studentId', async (req: AuthRequest, res) => {
  try {
    const { studentId } = req.params;
    const userId = req.user!.userId;

    // Проверить, что студент принадлежит учителю
    const student = await prisma.student.findFirst({
      where: {
        id: studentId,
        teacherId: userId
      }
    });

    if (!student) {
      return res.status(404).json({ error: 'Student not found' });
    }

    // Отвязать Telegram
    await prisma.student.update({
      where: { id: studentId },
      data: {
        telegramChatId: null,
        telegramUsername: null
      }
    });

    res.json({ success: true, message: 'Telegram unlinked successfully' });
  } catch (error) {
    console.error('Error unlinking Telegram:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

// Получить список студентов с их статусом привязки к Telegram
router.get('/status', async (req: AuthRequest, res) => {
  try {
    const userId = req.user!.userId;

    const students = await prisma.student.findMany({
      where: { teacherId: userId },
      select: {
        id: true,
        fullName: true,
        telegramChatId: true,
        telegramUsername: true,
        groupId: true,
        group: {
          select: {
            name: true
          }
        }
      },
      orderBy: { fullName: 'asc' }
    });

    const studentStatuses = students.map(student => ({
      id: student.id,
      fullName: student.fullName,
      groupName: student.group?.name || null,
      isLinked: !!student.telegramChatId,
      telegramUsername: student.telegramUsername
    }));

    res.json(studentStatuses);
  } catch (error) {
    console.error('Error fetching Telegram status:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

// Отправить домашнее задание студенту в Telegram
router.post('/send-homework', async (req: AuthRequest, res) => {
  try {
    const { studentId, groupId, date, topic, homework } = req.body;
    const userId = req.user!.userId;

    if (!date || !topic || !homework) {
      return res.status(400).json({ error: 'Date, topic, and homework are required' });
    }

    if (!studentId && !groupId) {
      return res.status(400).json({ error: 'Either studentId or groupId is required' });
    }

    // Импортируем функции отправки
    const { sendHomeworkToStudent, sendHomeworkToGroup } = await import('../services/telegram-bot');

    let result;
    if (studentId) {
      // Проверить, что студент принадлежит учителю
      const student = await prisma.student.findFirst({
        where: {
          id: studentId,
          teacherId: userId
        }
      });

      if (!student) {
        return res.status(404).json({ error: 'Student not found' });
      }

      const success = await sendHomeworkToStudent(studentId, { date, topic, homework });
      result = { sent: success ? 1 : 0, total: 1 };
    } else if (groupId) {
      // Проверить, что группа принадлежит учителю
      const group = await prisma.group.findFirst({
        where: {
          id: groupId,
          teacherId: userId
        }
      });

      if (!group) {
        return res.status(404).json({ error: 'Group not found' });
      }

      result = await sendHomeworkToGroup(groupId, { date, topic, homework });
    }

    res.json({
      success: true,
      ...result,
      message: `Homework sent to ${result?.sent || 0} out of ${result?.total || 0} students`
    });
  } catch (error) {
    console.error('Error sending homework via Telegram:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

export default router;
